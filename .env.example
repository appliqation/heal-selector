# appq connection — same account/org credentials the rest of the family uses.
APPQ_ORIGIN=https://appq.appliqation.io
APPQ_API_KEY=

# Set exactly one LLM provider — checked in this order, first configured
# wins: Anthropic, OpenAI, DeepSeek, GLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
ANTHROPIC_MODEL=
OPENAI_MODEL=
ANTHROPIC_MAX_TOKENS=8192
OPENAI_MAX_OUTPUT_TOKENS=8192

# DeepSeek and Zhipu's GLM — both OpenAI Chat Completions-compatible, routed
# through the same generic adapter. Unlike Anthropic/OpenAI, there is no
# built-in default model here — DEEPSEEK_MODEL/GLM_MODEL are REQUIRED when
# that provider is selected (model IDs on both move fast; a silently stale
# hardcoded default would be worse than an explicit startup error). Base
# URLs default to the public endpoints — override only for a proxy/self-host.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192
GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MAX_TOKENS=8192
# Note: this agent does drive a real browser (browser_navigate/browser_
# snapshot against the live page) but grounds a healed selector's identity
# in the accessibility-tree *text* snapshot, not a screenshot image — its
# browser_take_screenshot tool result is never wired into an LLM message's
# vision-image slot (checked as of this change: no `images` attachment
# anywhere in src/, unlike sibling agents autotest/visual-regression which
# do build one locally). So today, no provider here needs vision support.
# If that wiring is ever added, revisit before pointing this agent at
# DeepSeek (its public chat models are text-only) or a non-vision GLM model
# (only the GLM-4V-class variants support images).

# Overall tool-calling loop budget for one `heal` run — usually much shorter
# than a full script draft, since only one selector is in scope.
BUDGET_MAX_CALLS=30
BUDGET_MAX_PAGES=20
BUDGET_MAX_MILLIS=600000
BUDGET_MAX_TURNS=30
# Broad backstop against runaway spend, not a tuned budget — the caps above
# normally end a run first. Includes cache tokens.
BUDGET_MAX_TOTAL_TOKENS=1000000

# Wall-clock cap per individual run_command call (a targeted playwright test run).
COMMAND_TIMEOUT_MS=180000

# Playwright browser tools' evidence ring-buffer cap.
RING_BUFFER_CAP=50

# Audit logging — entirely opt-in, nothing is recorded anywhere unless one of
# these is set. Precedence: Mongo (if fully configured) > JSONL > none. This
# is a parallel system's own audit trail, deliberately not part of appq —
# see @appliqation/agent-core's audit/sink.ts. AUDIT_MONGO_DB/_COLLECTION
# are required together with AUDIT_MONGO_URI — no default collection name.
AUDIT_MONGO_URI=
AUDIT_MONGO_DB=
AUDIT_MONGO_COLLECTION=
AUDIT_JSONL_PATH=
